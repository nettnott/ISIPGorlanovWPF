<Window x:Class="ISIPGorlanovWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIPGorlanovWPF"
        mc:Ignorable="d"
        Title="Косметическая ложка" Height="1080" Width="1920">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#FF69B4" Margin="10">
            <TextBlock Text="Просто лажа" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,30,0,40" Foreground="White"/>
            <Button Content="Главная" Click="BtnMain_Click"/>
            <Button Content="Записаться" Click="BtnRecord_Click"/>
            <Button Content="Товары" Click="BtnProducts_Click"/>
            <Button x:Name="btnCart" Content="Корзина" Click="BtnCart_Click"/>
            <Button x:Name="btnAccount" Content="Мой аккаунт" Click="BtnAccount_Click"/>
            <Button x:Name="btnMaster" Content="Мастер" Click="BtnMaster_Click"/>
            <Button x:Name="btnManager" Content="Менеджер" Click="BtnManager_Click"/>
            <Button x:Name="btnAdmin" Content="Администратор" Click="BtnAdmin_Click"/>
            <Button Content="Выйти" Click="BtnLogout_Click" Margin="0,50,0,0" Background="#FF4D8C"/>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Margin="10"/>
    </Grid>
</Window>
