<Window x:Class="ISIPGorlanovWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIPGorlanovWPF"
        mc:Ignorable="d"
        Title="Начало работы" Height="450" Width="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ProgressBar x:Name="StepProgress" Grid.Row="0" Minimum="1" Maximum="5" Value="1" Height="20" Margin="20,0,20,0"/>
        <Frame x:Name="MainFrame" Grid.Row="1" Source="ChoiceModelNType.xaml" NavigationUIVisibility="Hidden"/>
        </Grid>
</Window>
