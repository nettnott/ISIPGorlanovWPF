<Page x:Class="ISIPGorlanovWPF.CreditParametres"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreditParametres">

    <Grid>
        <TextBlock Text="Шаг 4: Выберите параметры кредита" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="Взнос (руб):"/>
            <TextBox x:Name="txtFee" Margin="0,5"/>

            <TextBlock Text="Срок (мес):" Margin="0,10,0,0"/>
            <TextBox x:Name="txtTerm" Margin="0,5"/>

            <Button Content="Рассчитать" Click="BtnCalc_Click" Margin="0,15" Height="30"/>

            <TextBlock Text="Ежемесячный платеж:"/>
            <TextBlock x:Name="lblResult" Text="0 руб."/>
        </StackPanel>
        <Button Content="Далее" Click="GoNext_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Width="100"/>
        <Button Content="Назад" Click="GoBack_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" Width="100"/>

    </Grid>
</Page>
