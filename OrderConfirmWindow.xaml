<Window x:Class="ISIPGorlanovWPF.OrderConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIPGorlanovWPF"
        mc:Ignorable="d"
        Title="OrderConfirmWindow" Height="450" Width="800">
    <Grid Margin="30">
        <StackPanel Width="800" VerticalAlignment="Center">
            <TextBlock Text="Дата получения"/>
            <DatePicker x:Name="dpDate" Margin="0,5,0,15"/>
            <TextBlock Text="Способ оплаты"/>
            <ComboBox x:Name="cmbPayment" Margin="0,5,0,20">
                <ComboBoxItem>Наличные</ComboBoxItem>
                <ComboBoxItem>Карта</ComboBoxItem>
            </ComboBox>
            <Button Content="Подтвердить заказ" Height="50" Click="BtnConfirm_Click"/>
            <Button Content="Назад" Width="140" Click="BtnBack_Click" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>
