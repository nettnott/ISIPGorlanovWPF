<Window x:Class="ISIPGorlanovWPF.Pages.RecordInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIPGorlanovWPF.Pages"
        mc:Ignorable="d"
        Title="RecordInfoWindow" Height="450" Width="800">
    <Grid Margin="25">
        <StackPanel Width="800" VerticalAlignment="Center">
            <TextBlock x:Name="txtService" FontSize="18"/>
            <TextBlock x:Name="txtMaster" FontSize="18"/>
            <TextBlock x:Name="txtDate" FontSize="18" Margin="0,10"/>
            <ComboBox x:Name="cmbPayment" Margin="0,20,0,10">
                <ComboBoxItem>Наличные</ComboBoxItem>
                <ComboBoxItem>Карта</ComboBoxItem>
            </ComboBox>
            <TextBox x:Name="txtComment" Height="80" AcceptsReturn="True"/>
            <Button Content="Записаться" Height="50" Click="BtnRecord_Click" Margin="0,25,0,0"/>
            <Button Content="Назад" Width="140" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>
