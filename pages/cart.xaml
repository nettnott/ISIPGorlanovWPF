<Page x:Class="ISIPGorlanovWPF.pages.cart"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF.pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1600"
      Title="cart">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="CartList" Grid.Row="0" Grid.Column="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Center" Width="800">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10" Width="450">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="Black" FontSize="20"/>
                        <TextBlock Text="{Binding Cost, StringFormat='{}{0} руб.'}" Foreground="Gray" FontSize="18"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="NextBtn" Click="NextBtn_Click"  Content="Oformit` zakaz" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="1" Height="60" Width="200" FontSize="18" FontFamily="Ink Free"/>
        <Button x:Name="BackBtn" Click="BackBtn_Click"  Content="Exat` nazad" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" Height="60" Width="200" FontSize="18" FontFamily="Ink Free"/>
    </Grid>
</Page>
