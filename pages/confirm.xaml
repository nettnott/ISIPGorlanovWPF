<Page x:Class="ISIPGorlanovWPF.pages.confirm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF.pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1600"
      Title="confirm">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Input your info" FontSize="30" FontFamily="Ink Free" Margin="15" HorizontalAlignment="Center"/>
            <TextBox x:Name="NameTBx" Text="FIO" Height="40" Width="700" FontSize="24" Margin="0,25"/>
            <TextBox x:Name="MailTBx" Text="EMail" Height="40" Width="700" FontSize="24" Margin="0,25"/>
            <TextBox x:Name="AddressTBx" Text="Address" Height="40" Width="700" FontSize="24" Margin="0,25"/>
        
        </StackPanel>
        <Button x:Name="ConfirmBtn" Click="ConfirmBtn_Click"  Content="Zakazat scheine" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="1" Height="60" Width="200" FontSize="18" FontFamily="Ink Free"/>
        <Button x:Name="BackBtn" Click="BackBtn_Click"  Content="Exat` nazad" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" Height="60" Width="200" FontSize="18" FontFamily="Ink Free"/>
    </Grid>
</Page>
