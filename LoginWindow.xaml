<Window x:Class="ISIPGorlanovWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIPGorlanovWPF"
        mc:Ignorable="d"
        Title="LoginWindow" Height="700" Width="900">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" Width="800">
            <TextBlock Text="Косметическая лажа" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
            <TextBlock Text="Email"/>
            <TextBox x:Name="txtEmail" Height="35" Margin="0,5,0,15"/>
            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="txtPassword" Height="35" Margin="0,5,0,20"/>
            <Button Content="Войти" Height="45" Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
