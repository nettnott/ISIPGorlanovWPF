<Page x:Class="ISIPGorlanovWPF.Pages.MasterRecordInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="MasterRecordInfoPage">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock x:Name="txtInfo" FontSize="16" TextWrapping="Wrap" Height="220"/>
            <Button Content="Завершить услугу" Height="50" Width="300" Click="BtnComplete_Click" Margin="0,30"/>
            <Button Content="Назад" Width="140" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>
