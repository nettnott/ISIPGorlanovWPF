<Page x:Class="ISIPGorlanovWPF.Pages.MasterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="MasterPage">

    <Grid Margin="20">
        <StackPanel>
            <DataGrid x:Name="dgMyRecords" AutoGenerateColumns="True" MouseDoubleClick="dgMyRecords_MouseDoubleClick"/>
            <Button Content="Назад" Width="140" Click="BtnBack_Click" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Page>
