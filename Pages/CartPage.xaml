<Page x:Class="ISIPGorlanovWPF.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="CartPage">

    <Grid Margin="20">
        <StackPanel>
            <DataGrid x:Name="dgCart" AutoGenerateColumns="True" Height="340"/>
            <Button Content="Оформить заказ" Click="BtnOrder_Click" Height="50" Width="200" Margin="0,20"/>
            <Button Content="Назад" Click="BtnBack_Click" Width="140"/>
        </StackPanel>
    </Grid>
</Page>
