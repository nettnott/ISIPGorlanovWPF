<Page x:Class="ISIPGorlanovWPF.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="ProductsPage">

    <Grid Margin="20">
        <StackPanel>
            <TextBox x:Name="txtSearch" Width="300" Height="35"/>
            <Button Content="Поиск" Click="BtnSearch_Click" Width="100" Margin="0,10"/>
            <DataGrid x:Name="dgProducts" AutoGenerateColumns="True" MouseDoubleClick="dgProducts_MouseDoubleClick" Height="420"/>
            <Button Content="Назад" Width="140" Click="BtnBack_Click" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Page>
