<Page x:Class="ISIPGorlanovWPF.Pages.SavedBuilds"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SavedBuilds">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2.5*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Все сохраненные сборки" FontSize="18" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" Grid.Column="0" x:Name="HistoryListBox" SelectionChanged="HistoryListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding author}" Foreground="Gray" Margin="0,0,0,5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox Grid.Row="1" Grid.Column="1" x:Name="BuildGrid">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10,5">
                        <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding price, StringFormat={}{0:N0} руб.}" Foreground="HotPink"/>
                        <TextBlock Text="{Binding parttype_.name}" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Page>
