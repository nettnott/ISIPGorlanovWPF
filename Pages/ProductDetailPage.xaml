<Page x:Class="ISIPGorlanovWPF.Pages.ProductDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="ProductDetailPage">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock x:Name="txtName" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="txtPrice" FontSize="18" Margin="0,10"/>
            <TextBlock x:Name="txtDiscount" FontSize="16"/>
            <TextBlock x:Name="txtRating" FontSize="16"/>
            <TextBlock x:Name="txtDesc" TextWrapping="Wrap" Height="140" Margin="0,20"/>
            <Button Content="Добавить в корзину" Height="50" Click="BtnAddToCart_Click" Margin="0,30"/>
            <Button Content="Назад" Width="140" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>
