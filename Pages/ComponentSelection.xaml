<Page x:Class="ISIPGorlanovWPF.Pages.ComponentSelection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ComponentSelection">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="SearchBox" Width="150" TextChanged="FilterChanged"/>

                <TextBlock Text="Производитель:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <ComboBox x:Name="ManufacturerCombo" Width="120" SelectionChanged="FilterChanged" DisplayMemberPath="name"/>

                <Button Content="Сброс" Click="ResetFilter_Click" Margin="10,0,0,0" Background="LightGray" Foreground="Black"/>
            </StackPanel>

            <TextBlock Text="Доступные комплектующие:" Style="{StaticResource HeaderTitle}"/>
            <ListBox x:Name="PartsList" MaxHeight="700">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ItemCard}" Width="180">
                            <StackPanel>
                                <Image Source="{Binding image}" Height="100" Stretch="Uniform"/>
                                <TextBlock Text="{Binding name}" TextWrapping="Wrap" Height="40" FontWeight="Bold" Margin="0,5"/>
                                <TextBlock Text="{Binding price, StringFormat={}{0:N0} руб.}" Foreground="DimGray"/>
                                <Button x:Name="AddPart_BTN" Content="Добавить" Tag="{Binding id}" Click="AddPart_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="10" Padding="10">
            <StackPanel>
                <TextBlock Text="Ваша сборка:" Style="{StaticResource HeaderTitle}"/>
                <ListBox x:Name="SelectedPartsList" Height="150" Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="220">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding name}" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding price, StringFormat={}{0:N0} руб.}" Foreground="DimGray"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <TextBlock Text="Итоговая цена:" Margin="0,10,0,0"/>
                <TextBlock x:Name="PriceLabel" Text="0 руб." FontSize="20" FontWeight="Bold"/>

                <TextBlock Text="Название сборки:" Margin="0,10,0,0"/>
                <TextBox x:Name="BuildName" />

                <TextBlock Text="Ваше имя:"/>
                <TextBox x:Name="AuthorName" />

                <Button x:Name="SaveBuild_BTN" Content="Сохранить" Click="SaveBuild_BTN_Click"/>
                <Button x:Name="OpenHistory_BTN" Content="Открыть билды" Click="OpenHistory_BTN_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
