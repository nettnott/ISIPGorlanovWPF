<Page x:Class="ISIPGorlanovWPF.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1600"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="FilmsList" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="20" Orientation="Horizontal" Width="500">
                        <Image Source="{Binding Cover}" Stretch="Uniform" Margin="5" HorizontalAlignment="Left" Width="200"/>
                        <StackPanel Margin="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontFamily="Ink Free" FontSize="20" TextWrapping="Wrap"  FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Rate, StringFormat='Рейтинг: {0}'}" FontWeight="Medium" Foreground="DeepPink" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding StartOfRental, StringFormat='Начало показа: {0}'}" FontWeight="Light" Foreground="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AgeRateID.Name, StringFormat='Возрастной рейтинг: {0}'}" FontWeight="Medium" Foreground="HotPink" HorizontalAlignment="Center"/>
                            <Button x:Name="InfoBTN" Content="more info" Width="100" Height="20" Margin="5" Click="InfoBTN_Click" HorizontalAlignment="Center" FontWeight="Heavy" FontFamily="Ink Free" Background="LightPink"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="SideStP" Grid.Column="2" Grid.Row="0" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="Поиск: " Width="300" Height="40" Margin="5, 10" FontFamily="Ink Free" FontSize="30" FontWeight="Bold" Foreground="DeepPink" />
            <TextBox x:Name="SearchTB" TextChanged="SearchTB_TextChanged" Width="300" Height="35" Margin="5" Padding="5" FontSize="18"/>
            <TextBlock Text="Сортировка: " Width="300" Height="40" Margin="5, 10" FontFamily="Ink Free" FontSize="30" FontWeight="Bold" Foreground="DeepPink" />
            <StackPanel x:Name="SortSP"  Width="300" Margin="10">
                <RadioButton x:Name="ByNameRB" GroupName="Type" Content="По названию" FontSize="18"/>
                <RadioButton x:Name="ByRateRB" GroupName="Type" Content="По рейтингу" FontSize="18"/>
                <Rectangle Fill="LightPink" Width="280" Height="1" Margin="5"/>
                <RadioButton x:Name="ByAscRB" GroupName="DescNo" Content="По возрастанию" FontSize="18"/>
                <RadioButton x:Name="ByDescRB" GroupName="DescNo" Content="По убыванию" FontSize="18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ConfSortBTN" Click="ConfSortBTN_Click" HorizontalAlignment="Left" Content="Сортировать" Width="100" Height="20" Margin="10" FontWeight="Heavy" FontFamily="Ink Free" Background="LightPink"/>
                    <Button x:Name="ResetBTN" Click="ResetBTN_Click" HorizontalAlignment="Right" Content="Сбросить" Width="100" Height="20" Margin="10" FontWeight="Heavy" FontFamily="Ink Free" Background="LightPink"/>
                </StackPanel>
            </StackPanel>
            <Rectangle Fill="LightPink" Width="280" Height="1" Margin="10"/>
            <Button x:Name="LogInBTN" Click="LogInBTN_Click" HorizontalAlignment="Center" Content="Войти в аккаунт" Width="250" Height="35" Margin="15" FontWeight="Heavy" FontFamily="Ink Free" Background="DeepPink" FontSize="20"/>
            <Button x:Name="CreateAccBTN" Click="CreateAccBTN_Click" HorizontalAlignment="Center" Content="Создать аккаунт" Width="250" Height="35" Margin="15" FontWeight="Heavy" FontFamily="Ink Free" Background="HotPink" FontSize="20"/>
        </StackPanel>
    </Grid>
</Page>
