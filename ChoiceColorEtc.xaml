<Page x:Class="ISIPGorlanovWPF.ChoiceColorEtc"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIPGorlanovWPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChoiceColorEtc">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Шаг 2: Выберите цвет кузова и доп детали" HorizontalAlignment="Center" FontWeight="Bold" Margin="10"/>

        <TextBlock Grid.Row="1" Text="Выберите цвет:" Margin="5,0"/>
        <ListBox x:Name="listColors" Grid.Row="2" Margin="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                <Run Text="{Binding Name}" FontWeight="Bold"/>
                <Run Text=" | Цена: "/> <Run Text="{Binding Price}"/> <Run Text=" руб."/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Text="Выберите дополнения:" Margin="5,0"/>
        <ListBox x:Name="listOptions" Grid.Row="4" Margin="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                <Run Text="{Binding Name}" FontWeight="Bold"/>
                <Run Text=" | Цена: "/> <Run Text="{Binding Price}"/> <Run Text=" руб."/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="5" Content="Назад" Click="GoBack_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" Width="100"/>
        <Button Grid.Row="5" Content="Далее" Click="GoNext_Click" HorizontalAlignment="Right" Margin="10" Width="100" Height="30"/>
    </Grid>
</Page>
